{
  "system_name": "Employee Safety CCTV System v1.0",
  "description": "Professional CCTV monitoring for workplace safety and compliance",
  
  "cameras": [
    {
      "id": "CAM_001",
      "source": 0,
      "location": "Main Entrance",
      "zones": ["ZONE_MAIN"],
      "enabled": true
    }
  ],
  
  "zones": [
    {
      "id": "ZONE_MAIN",
      "type": "high_risk",
      "name": "Main Work Area",
      "coordinates": [[0, 0], [1280, 0], [1280, 720], [0, 720]],
      "min_ppe": {
        "helmet": true,
        "gloves": false,
        "vest": false
      },
      "restricted": false,
      "description": "Main workspace requiring helmet"
    }
  ],
  
  "employees": [
    {
      "id": "EMP001",
      "name": "Test Employee",
      "role": "Operator",
      "department": "Operations",
      "required_ppe": {
        "helmet": true,
        "gloves": true,
        "vest": false
      }
    }
  ],
  
  "recording": {
    "enabled": true,
    "fps": 15,
    "resolution": [1280, 720],
    "codec": "mp4v",
    "max_disk_usage_gb": 100,
    "output_dir": "recordings",
    "daily_rotation": true,
    "backup_old_files": false
  },
  
  "detection": {
    "helmet_confidence_threshold": 0.5,
    "worker_detection_threshold": 0.5,
    "min_detection_frames": 3,
    "model_type": "cascade",
    "color_ranges": {
      "yellow_helmet": true,
      "orange_helmet": true,
      "white_helmet": true,
      "red_helmet": true,
      "blue_helmet": true
    }
  },
  
  "alerts": {
    "enabled": true,
    "severities": ["low", "medium", "high", "critical"],
    "alert_types": [
      "missing_helmet",
      "missing_ppe",
      "unauthorized_access",
      "zone_violation",
      "excessive_violations"
    ],
    "cooldown_minutes": {
      "low": 5,
      "medium": 3,
      "high": 1,
      "critical": 0.17
    },
    "escalation": {
      "enabled": true,
      "levels": [
        {"level": 1, "action": "email", "threshold": 1},
        {"level": 2, "action": "sms", "threshold": 3},
        {"level": 3, "action": "call", "threshold": 5},
        {"level": 4, "action": "block_access", "threshold": 10}
      ]
    },
    "notifications": {
      "email_enabled": false,
      "sms_enabled": false,
      "webhook_enabled": false,
      "email_recipients": [],
      "webhook_url": ""
    }
  },
  
  "analytics": {
    "enabled": true,
    "incident_retention_days": 90,
    "generate_daily_reports": true,
    "report_time": "06:00",
    "metrics": [
      "compliance_rate",
      "incident_count",
      "top_violators",
      "zone_violations",
      "peak_hours"
    ]
  },
  
  "web_interface": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 5000,
    "debug": false,
    "threaded": true,
    "dashboard_refresh_seconds": 5,
    "camera_feed_fps": 15
  },
  
  "logging": {
    "level": "INFO",
    "file": "cctv_system.log",
    "max_file_size_mb": 50,
    "backup_count": 5,
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  },
  
  "performance": {
    "max_threads": 8,
    "frame_queue_size": 30,
    "detection_timeout_seconds": 5,
    "recording_buffer_size": 100
  }
}
