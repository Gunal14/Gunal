# Environment Configuration for AI Safety Monitoring System
# Copy this file to .env and fill in your values

# ==========================================
# SECURITY SETTINGS (REQUIRED)
# ==========================================

# Secret key for Flask sessions and JWT tokens
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-secret-key-here

# JWT Secret Key (can be same as SECRET_KEY or different)
JWT_SECRET_KEY=your-jwt-secret-key-here

# ==========================================
# DATABASE SETTINGS
# ==========================================

# Database URL (SQLite for development, PostgreSQL/MySQL for production)
DATABASE_URL=sqlite:///safety_monitoring.db

# ==========================================
# EMAIL SETTINGS (for notifications)
# ==========================================

# SMTP server settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ==========================================
# APPLICATION SETTINGS
# ==========================================

# Environment (development, production, testing)
FLASK_ENV=development

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ==========================================
# AI/ML SETTINGS
# ==========================================

# Detection thresholds (0.0 to 1.0)
HELMET_THRESHOLD=0.5
WORKER_THRESHOLD=0.5

# Camera settings
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
MAX_CAMERAS=16

# ==========================================
# MONITORING SETTINGS
# ==========================================

# Alert cooldown periods (seconds)
ALERT_COOLDOWN=60
INCIDENT_RETENTION_DAYS=180

# ==========================================
# PRODUCTION SECURITY
# ==========================================

# Enable HTTPS in production
ENABLE_HTTPS=false

# SSL Certificate paths (for production)
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key