# Environment Configuration Template
# Copy this file to .env and fill in your configuration

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# Database Configuration
DATABASE_URL=sqlite:///safety_monitoring.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/safety_monitoring

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=True
MAIL_DEFAULT_SENDER=noreply@safety-monitoring.com

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Camera Configuration
MAX_CAMERAS=16
DETECTION_THRESHOLD_HELMET=0.5
DETECTION_THRESHOLD_WORKER=0.5

# Alert Configuration
ALERT_COOLDOWN_SECONDS=5
ALERT_EMAIL_ENABLED=True
ALERT_SMS_ENABLED=False
ALERT_WEBHOOK_ENABLED=True

# SMS Configuration (if enabled)
SMS_PROVIDER=twilio  # Options: twilio, aws_sns
TWILIO_ACCOUNT_SID=your-twilio-account
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+1234567890

# Data Retention Policies
RETENTION_DAYS_LOGS=90
RETENTION_DAYS_INCIDENTS=180
RETENTION_DAYS_VIDEO=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/safety_monitoring.log

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Performance
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True

# Server Configuration
HOST=0.0.0.0
PORT=5000
WORKERS=4

# API Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_REQUESTS_PER_MINUTE=60

# Monitoring & Analytics
ENABLE_PERFORMANCE_MONITORING=True
ENABLE_ANALYTICS=True

# Feature Flags
FEATURE_EMAIL_ALERTS=True
FEATURE_SMS_ALERTS=False
FEATURE_WEBHOOK_ALERTS=True
FEATURE_MULTI_CAMERA=True
FEATURE_ADVANCED_DETECTION=True

# External Integrations
WEBHOOK_URL=https://your-company.com/safety-alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Production Settings (enable only in production)
ENABLE_HTTPS=False
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=False

# Admin User (initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@company.com
